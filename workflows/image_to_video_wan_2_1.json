{
  "workflow_name": "Image-to-Video (Wan 2.1 1.3B)",
  "version": "1.0",
  "description": "Image animation using Wan 2.1 1.3B model with motion guidance",
  "model_name": "wan_2_1_1_3b",
  "notes": "Animates a static image into video with optional text-based motion guidance",
  "nodes": {
    "1": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": {
        "ckpt_name": "wan_2_1_1_3b.safetensors"
      }
    },
    "2": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "placeholder_motion_prompt",
        "clip": ["1", 1]
      }
    },
    "3": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "placeholder_negative_prompt",
        "clip": ["1", 1]
      }
    },
    "4": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "default.vae.safetensors"
      }
    },
    "5": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "placeholder_input_image.png"
      }
    },
    "6": {
      "class_type": "VAEEncode",
      "inputs": {
        "pixels": ["5", 0],
        "vae": ["4", 0]
      }
    },
    "7": {
      "class_type": "KSamplerSimple",
      "inputs": {
        "seed": 0,
        "steps": 20,
        "cfg": 7.5,
        "sampler_name": "euler",
        "scheduler": "normal",
        "denoise": 0.75,
        "model": ["1", 0],
        "positive": ["2", 0],
        "negative": ["3", 0],
        "latent_image": ["6", 0]
      }
    },
    "8": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": ["7", 0],
        "vae": ["4", 0]
      }
    },
    "9": {
      "class_type": "VHS_VideoCombine",
      "inputs": {
        "images": ["8", 0],
        "frame_rate": 8,
        "loop_count": 0,
        "format": "video/mp4",
        "pingpong": false,
        "save_output": true
      }
    }
  },
  "links": [
    [1, 1, 1, 2, 1, "CLIP"],
    [2, 1, 1, 3, 1, "CLIP"],
    [3, 1, 0, 7, 0, "MODEL"],
    [4, 2, 0, 7, 1, "CONDITIONING"],
    [5, 3, 0, 7, 2, "CONDITIONING"],
    [6, 6, 0, 7, 3, "LATENT"],
    [7, 7, 0, 8, 0, "SAMPLES"],
    [8, 4, 0, 8, 1, "VAE"],
    [9, 8, 0, 9, 0, "IMAGE"]
  ],
  "binding_hints": {
    "prompt": {
      "node": "2",
      "input": "text",
      "type": "text"
    },
    "negative_prompt": {
      "node": "3",
      "input": "text",
      "type": "text"
    },
    "image": {
      "node": "5",
      "input": "image",
      "type": "image_path"
    },
    "frames": {
      "node": "6",
      "input": "length",
      "type": "int"
    },
    "fps": {
      "node": "9",
      "input": "frame_rate",
      "type": "int"
    },
    "seed": {
      "node": "7",
      "input": "seed",
      "type": "int"
    }
  }
}
